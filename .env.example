# KnowFlow 环境变量模板
# 用法：复制本文件为 .env，填入真实值；.env 本身切勿上传（已在 .gitignore 排除）。
# 生成口令哈希：python "RAG MVP/gen_password_hash.py"

# 必填：DeepSeek API Key
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 必填：管理员口令（推荐存哈希串，用 gen_password_hash.py 生成）
# 明文兼容写法（不推荐）：KNOWFLOW_ADMIN_PASSWORD=admin123
KNOWFLOW_ADMIN_PASSWORD=pbkdf2$200000$<base64盐>$<base64哈希>

# 必填：Flask 会话签名密钥（部署时务必换成随机强字符串）
FLASK_SECRET_KEY=replace_with_a_random_strong_secret

# 可选覆盖项（不设则用代码内默认值）：
# KNOWFLOW_ADMIN_TTL=3600              # 管理员登录态有效期（秒），默认 1 小时
# KNOWFLOW_MAX_LOGIN_FAILS=5           # 连续登录失败上限，默认 5 次
# KNOWFLOW_LOGIN_LOCK_SECONDS=900      # 被锁定时长（秒），默认 15 分钟
